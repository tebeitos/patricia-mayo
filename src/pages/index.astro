---
import Layout from '../layouts/Layout.astro';
import { negocio, servicios } from '../data/negocio';

const title = "Patricia Mayo · Makeup Artist · Gijón, Asturias";
const description = "Maquillaje de fiesta, noche, sesiones fotográficas y transformación artística. Patricia Mayo, makeup artist en Gijón y Asturias.";
---

<Layout title={title} description={description}>
  <!-- HEADER TRANSPARENTE CON NAVEGACIÓN Y MENÚ HAMBURGUESA -->
  <header class="site-header">
    <div class="container header-inner">
      <!-- Menú Hamburguesa en la izquierda -->
      <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menú">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- Logo en la derecha -->
      <a href="/" class="logo-link">
        <img src="/logo.png" alt="Patricia Mayo" class="logo-img" />
      </a>

      <!-- Overlay Menú Navegación -->
      <nav id="mobile-menu" class="mobile-menu bg-negro">
        <button id="menu-close" class="menu-close" aria-label="Cerrar menú">&times;</button>
        <ul class="menu-list">
          <li><a href="#servicios" class="menu-link">Servicios</a></li>
          <li><a href="#galeria" class="menu-link">Galería</a></li>
          <li><a href="#sobre-mi" class="menu-link">Sobre Patricia</a></li>
          <li><a href="#reservar" class="menu-link text-terracota">Reservar</a></li>
          <li><a href={negocio.instagram} target="_blank" rel="noopener noreferrer" class="menu-link">Instagram</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <!-- SECCIÓN 1 — HERO -->
    <section class="hero-section bg-negro">
      <div class="hero-bg-wrap">
        <img src="/hero.jpg" alt="Patricia Mayo Makeup Hero" class="hero-img" />
        <div class="hero-overlay"></div>
      </div>
      
      <div class="container hero-content-container">
        <div class="hero-text-block">
          <h1 class="hero-heading">
            <span class="hero-line">El maquillaje que dura más que tus planes.</span>
          </h1>

          <!-- Botones de WhatsApp y Correo al lado abajo del titular -->
          <div class="hero-contact-row">
            <a 
              href="https://wa.me/34691352577?text=Hola%20Patricia%2C%20me%20gustar%C3%ADa%20reservar%20una%20cita%20contigo." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hero-contact-btn hero-whatsapp-btn"
              aria-label="Contactar por WhatsApp"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.205 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>WhatsApp</span>
            </a>

            <a 
              href="mailto:makeuppatti@gmail.com" 
              class="hero-contact-btn hero-email-btn"
              aria-label="Enviar un Email"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <span>Email</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2 — GALERÍA CORTA -->
    <section class="galeria-corta bg-negro">
      <div class="container-fluid">
        <div class="galeria-corta-grid">
          <div class="galeria-corta-item">
            <img src="/galeria8.jpg" alt="Maquillaje Patricia Mayo 1" loading="lazy" />
          </div>
          <div class="galeria-corta-item">
            <img src="/galeria1.jpg" alt="Maquillaje Patricia Mayo 2" loading="lazy" />
          </div>
          <div class="galeria-corta-item">
            <img src="/galeria6.jpg" alt="Maquillaje Patricia Mayo 3" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 3 — FRASE DE CLIENTA -->
    <section class="frase-clienta bg-crema">
      <div class="container frase-container">
        <blockquote class="quote-text">
          “Llegué a casa a las seis de la mañana<br />y seguía impecable.”
        </blockquote>
        <span class="quote-author">— Cliente real</span>
      </div>
    </section>

    <!-- SECCIÓN 4 — SERVICIOS -->
    <section id="servicios" class="servicios-section bg-crema">
      <div class="container servicios-container">
        <h2 class="servicios-titulo-principal">Lo que hago</h2>

        <div class="servicios-lista">
          {servicios.map((servicio, index) => (
            <div class="servicio-bloque">
              {index > 0 && <hr class="servicio-divider" />}
              <div class="servicio-contenido">
                <span class="numero-servicio">{servicio.numero}</span>
                <h3 class="servicio-titulo">{servicio.titulo}</h3>
                <p class="servicio-descripcion">{servicio.descripcion}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECCIÓN 5 — GALERÍA COMPLETA -->
    <section id="galeria" class="galeria-completa bg-negro">
      <div class="container">
        <div class="galeria-grid-2col">
          <div class="galeria-img-wrap">
            <img src="/galeria7.jpg" alt="Trabajo Maquillaje 1" loading="lazy" />
          </div>
          <div class="galeria-img-wrap">
            <img src="/galeria4.jpg" alt="Trabajo Maquillaje 2" loading="lazy" />
          </div>
        </div>

        <div class="galeria-footer-link">
          <a 
            href="https://www.behance.net/2a1edc00?utm_source=ig&utm_medium=social&utm_content=link_in_bio&fbclid=PAb21jcAUGj_5wZG9mAmV4dG4DYWVtAjExAHNydGMGYXBwX2lkDzU2NzA2NzM0MzM1MjQyNwABpzSFYuSSOJcwfZfmb4vjWLz58LQr5mFua_7aiqzAltxN7q1t8PYRWABMgyBD_aem_ZUC-SLi8TXebbGpMeeDGCQ" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="link-instagram"
          >
            Ver más en Behance &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 6 — SOBRE PATRICIA -->
    <section id="sobre-mi" class="sobre-patricia bg-crema">
      <div class="container sobre-container">
        <div class="sobre-grid">
          <div class="sobre-col-foto">
            <img src="/patricia.jpg" alt="Patricia Mayo Makeup Artist" class="sobre-foto" loading="lazy" />
          </div>
          <div class="sobre-col-texto">
            <p class="sobre-parrafo sobre-destacado">
              Hay una foto mía con doce años pintándole los ojos a una amiga antes de una fiesta de cumpleaños. Mi amiga llegó a la fiesta y todo el mundo le preguntó qué se había hecho.
            </p>
            <p class="sobre-parrafo sobre-destacado-sub">
              Yo no lo sabía entonces, pero ya había encontrado lo mío.
            </p>
            <p class="sobre-parrafo">
              Años después me fui a Madrid a formarme, en el Alberto Dugarte Institute. Regresé a Gijón y trabajé como asesora de imagen para Chanel y para clientas que llegaban con prisa y se iban con otra cara. Luego vinieron los shootings para Siroko, sesiones de moda, fotógrafos que exigen con rapidez exactamente lo que necesitan y ni un milímetro más.
            </p>
            <p class="sobre-parrafo">
              En Asturias está mi gente y son las que me llaman para la boda de su hermana. Las que aparecen el sábado a las siete de la tarde con un vestido y sin saber qué hacer con la raya del ojo. Las que llevan años poniéndose en mis manos.
            </p>
            <p class="sobre-parrafo sobre-criterio">
              Pero me desplazo a donde haga falta cuando la ocasión lo merece. Sigo haciendo básicamente lo mismo que con doce años.<br />
              <strong>Solo que ahora sé lo que hago.</strong>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 7 — RESERVAR -->
    <section id="reservar" class="reservar-section bg-negro">
      <div class="container reservar-container">
        <h2 class="reservar-titulo">¿Tienes una fecha en mente?</h2>
        <p class="reservar-subtitulo">
          Cuéntame qué necesitas.<br />
          Respondo rápido.
        </p>

        <div class="reservar-action">
          <a 
            href="https://wa.me/34691352577?text=Hola%20Patricia%2C%20me%20gustar%C3%ADa%20reservar%20una%20cita%20contigo." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-naranja btn-reservar-lg"
          >
            &rarr; Escríbeme por WhatsApp
          </a>
        </div>

        <div class="reservar-alt">
          <a href={negocio.instagram} target="_blank" rel="noopener noreferrer" class="link-instagram-alt">
            O en Instagram · @makeuppatti
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="site-footer bg-negro">
    <div class="container footer-content">
      <div class="footer-principal">
        <p class="footer-linea">Patricia Mayo · Makeup Artist</p>
        <p class="footer-linea">Gijón · Asturias</p>
        <p class="footer-linea">
          <a href={negocio.instagram} target="_blank" rel="noopener noreferrer" class="footer-ig">@makeuppatti</a>
        </p>
      </div>

      <div class="footer-legal">
        <a href="/aviso-legal">Aviso Legal</a>
        <span class="footer-legal-sep">·</span>
        <a href="/privacidad">Política de Privacidad</a>
        <span class="footer-legal-sep">·</span>
        <span>© 2026 Patricia Mayo</span>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Menú Hamburguesa interactivo
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuLinks = document.querySelectorAll('.menu-link');

  function openMenu() {
    mobileMenu?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.remove('active');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);

  menuLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>

<style>
  /* Header transparente integrado dentro de la foto */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.25rem 0;
    background: transparent;
    border-bottom: none;
    width: 100%;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-img {
    height: 26px;
    max-width: 180px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: brightness(0) invert(1); /* Pasa el logo a crema/blanco sobre la foto */
  }

  /* Menú Hamburguesa en crema sobre la foto */
  .menu-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    padding: 8px;
    z-index: 110;
    flex-shrink: 0;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-crema);
    transition: transform 0.3s ease, opacity 0.3s ease;
    border-radius: 1px;
  }

  /* Mobile menu overlay */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    z-index: 300;
    background-color: var(--color-negro);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-menu.active {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: transparent;
    border: none;
    color: var(--color-crema);
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem;
  }

  .menu-list {
    list-style: none;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .menu-link {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-crema);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .menu-link:hover {
    color: var(--color-terracota);
  }

  /* SECCIÓN 1 — HERO */
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 650px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-bg-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg, 
      rgba(13, 13, 13, 0.45) 0%, 
      rgba(13, 13, 13, 0.2) 50%, 
      rgba(13, 13, 13, 0.85) 100%
    );
  }

  .hero-content-container {
    position: relative;
    z-index: 10;
    padding-bottom: 8.5rem;
  }

  .hero-text-block {
    max-width: 750px;
  }

  .hero-heading {
    display: flex;
    flex-direction: column;
    margin-bottom: 2rem;
  }

  .hero-line {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 6.5vw, 5.25rem);
    color: var(--color-crema);
    line-height: 1.08;
    word-break: break-word;
  }

  .hero-contact-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.25rem;
  }

  .hero-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.65rem;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .hero-whatsapp-btn {
    background-color: var(--color-terracota);
    color: var(--color-crema);
    border: 1px solid transparent;
  }

  .hero-whatsapp-btn:hover {
    background-color: #d0653d;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 10px 25px rgba(224, 118, 77, 0.45);
  }

  .hero-email-btn {
    background-color: rgba(255, 255, 255, 0.12);
    color: var(--color-crema);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero-email-btn:hover {
    background-color: rgba(255, 255, 255, 0.22);
    border-color: var(--color-crema);
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 10px 25px rgba(255, 255, 255, 0.2);
  }

  /* SECCIÓN 2 — GALERÍA CORTA */
  .galeria-corta {
    padding: 0;
    overflow: hidden;
  }

  .container-fluid {
    width: 100%;
    padding: 0;
  }

  .galeria-corta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    gap: 0;
  }

  .galeria-corta-item {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .galeria-corta-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transition: transform 0.5s ease;
  }

  .galeria-corta-item:hover img {
    transform: scale(1.03);
  }

  /* SECCIÓN 3 — FRASE DE CLIENTA */
  .frase-clienta {
    padding: 8rem 1.5rem;
    text-align: center;
  }

  .frase-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .quote-text {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: var(--color-grafito);
    line-height: 1.25;
    margin-bottom: 2rem;
    font-weight: 400;
  }

  .quote-author {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-grafito);
    opacity: 0.65;
    display: block;
  }

  /* SECCIÓN 4 — SERVICIOS */
  .servicios-section {
    padding: 6rem 1.5rem 8rem;
  }

  .servicios-container {
    max-width: 900px;
  }

  .servicios-titulo-principal {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 4.5vw, 3.75rem);
    color: var(--color-grafito);
    margin-bottom: 4rem;
  }

  .servicios-lista {
    display: flex;
    flex-direction: column;
  }

  .servicio-bloque {
    display: flex;
    flex-direction: column;
  }

  .servicio-divider {
    border: none;
    height: 1px;
    background-color: var(--color-terracota);
    opacity: 0.6;
    margin: 3.5rem 0;
  }

  .servicio-contenido {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .servicio-bloque .numero-servicio {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .servicio-titulo {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--color-grafito);
    margin-bottom: 1rem;
  }

  .servicio-descripcion {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: var(--color-grafito);
    line-height: 1.7;
    max-width: 720px;
    opacity: 0.9;
  }

  /* SECCIÓN 5 — GALERÍA COMPLETA */
  .galeria-completa {
    padding: 8rem 1.5rem;
  }

  .galeria-grid-2col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  .galeria-img-wrap {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .galeria-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 0.6s ease;
  }

  .galeria-img-wrap:hover img {
    transform: scale(1.04);
  }

  .galeria-footer-link {
    text-align: center;
  }

  .link-instagram {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-crema);
    text-decoration: none;
    display: inline-block;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .link-instagram:hover {
    color: var(--color-terracota);
    transform: translateX(4px);
  }

  /* SECCIÓN 6 — SOBRE PATRICIA */
  .sobre-patricia {
    padding: 8rem 1.5rem;
  }

  .sobre-container {
    max-width: 1100px;
  }

  .sobre-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .sobre-col-foto {
    width: 100%;
  }

  .sobre-foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .sobre-col-texto {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sobre-parrafo {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    color: var(--color-grafito);
    line-height: 1.5;
  }

  .sobre-destacado {
    font-size: 1.625rem;
  }

  .sobre-destacado-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--color-terracota);
  }

  .sobre-criterio {
    font-style: italic;
    color: var(--color-terracota);
    font-size: 1.5rem;
  }

  /* SECCIÓN 7 — RESERVAR */
