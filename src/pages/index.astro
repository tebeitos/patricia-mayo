---
import Layout from '../layouts/Layout.astro';
import { negocio, servicios } from '../data/negocio';

const title = "Patricia Mayo · Makeup Artist · Gijón, Asturias";
const description = "Maquillaje de fiesta, noche, sesiones fotográficas y transformación artística. Patricia Mayo, makeup artist en Gijón y Asturias.";
---

<Layout title={title} description={description}>
  <!-- HEADER TRANSPARENTE CON NAVEGACIÓN Y MENÚ HAMBURGUESA -->
  <header class="site-header">
    <div class="container header-inner">
      <!-- Menú Hamburguesa en la izquierda -->
      <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menú">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- Logo en la derecha -->
      <a href="/" class="logo-link">
        <img src="/logo.png" alt="Patricia Mayo" class="logo-img" />
      </a>
    </div>
  </header>

  <!-- Overlay Menú Navegación -->
  <nav id="mobile-menu" class="mobile-menu bg-negro">
    <button id="menu-close" class="menu-close" aria-label="Cerrar menú">&times;</button>
    <ul class="menu-list">
      <li><a href="#servicios" class="menu-link">Servicios</a></li>
      <li><a href="#galeria" class="menu-link">Galería</a></li>
      <li><a href="/sobre-mi" class="menu-link">Sobre mí</a></li>
      <li><a href="#reservar" class="menu-link text-terracota">Contactar</a></li>
    </ul>
  </nav>

  <main>
    <!-- SECCIÓN 1 — HERO -->
    <section class="hero-section bg-negro">
      <div class="hero-bg-wrap">
        <img src="/hero.jpg" alt="Patricia Mayo Makeup Hero" class="hero-img" />
        <div class="hero-overlay"></div>
      </div>
    </section>

    <!-- SECCIÓN 3 — FRASE DE CLIENTA -->
    <section class="frase-clienta bg-crema">
      <div class="container frase-container">
        <blockquote class="quote-text">
          “Llegué a casa a las seis de la mañana<br />y seguía impecable.”
        </blockquote>
        <span class="quote-author">— Cliente real</span>
      </div>
    </section>

    <!-- SECCIÓN 2 — GALERÍA CORTA -->
    <section class="galeria-corta bg-negro">
      <div class="container-fluid">
        <div class="galeria-corta-grid">
          <div class="galeria-corta-item">
            <img src="/galeria8.jpg" alt="Maquillaje Patricia Mayo 1" loading="lazy" />
          </div>
          <div class="galeria-corta-item">
            <img src="/galeria1.jpg" alt="Maquillaje Patricia Mayo 2" loading="lazy" />
          </div>
          <div class="galeria-corta-item">
            <img src="/galeria6.jpg" alt="Maquillaje Patricia Mayo 3" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- BOTONES DE CONTACTO FLOTANTES FIJOS (A LA DERECHA, PERMANECEN FIJOS AL HACER SCROLL) -->
    <div class="floating-contact-bar">
      <a 
        href="https://wa.me/34691352577?text=Hola%20Patricia%2C%20me%20gustar%C3%ADa%20reservar%20una%20cita%20contigo." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="floating-contact-btn whatsapp-btn"
        aria-label="Contactar por WhatsApp"
        title="WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.205 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>

      <a 
        href="mailto:makeuppatti@gmail.com" 
        class="floating-contact-btn email-btn"
        aria-label="Enviar un Email"
        title="Email"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </a>
    </div>



    <!-- SECCIÓN 4 — SERVICIOS -->
    <section id="servicios" class="servicios-section bg-crema">
      <div class="container servicios-container">
        <div class="servicios-intro">
          <h2 class="servicios-saludo">Hola, soy Patricia Mayo.</h2>
          <p class="servicios-bio-intro">
            Soy maquilladora profesional y trabajo en Gijón, en toda Asturias y donde haga falta cuando la ocasión lo merece.
          </p>
          <p class="servicios-bajada">Esto es lo que puedo hacer por ti:</p>
        </div>

        <div class="servicios-lista">
          {servicios.map((servicio, index) => (
            <div class="servicio-bloque">
              {index > 0 && <hr class="servicio-divider" />}
              <div class="servicio-contenido">
                <span class="numero-servicio">{servicio.numero}</span>
                <h3 class="servicio-titulo">{servicio.titulo}</h3>
                <p class="servicio-descripcion">{servicio.descripcion}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECCIÓN 5 — GALERÍA COMPLETA -->
    <section id="galeria" class="galeria-completa bg-negro">
      <div class="container">
        <h2 class="galeria-titulo-principal">Galería</h2>

        <div class="galeria-pendiente-box">
          <p class="galeria-pendiente-texto">
            Pendiente de que Doña Patty pase sus fotos más tops.
          </p>
          <span class="galeria-pendiente-sub">Próximamente nueva selección de fotografías</span>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 7 — RESERVAR -->
    <section id="reservar" class="reservar-section bg-crema">
      <div class="container reservar-container">
        <h2 class="reservar-titulo">¿Tienes una fecha en mente?</h2>
        <p class="reservar-subtitulo">
          Cuéntame qué necesitas.<br />
          Respondo en menos de 24 horas.
        </p>

        <div class="reservar-buttons-group">
          <a 
            href="https://wa.me/34691352577?text=Hola%20Patricia%2C%20me%20gustar%C3%ADa%20reservar%20una%20cita%20contigo." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-naranja btn-reservar-lg"
          >
            &rarr; Escríbeme por WhatsApp
          </a>

          <a 
            href="mailto:makeuppatti@gmail.com" 
            class="btn-email-reservar"
          >
            &rarr; Envíame un email
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="site-footer bg-negro">
    <div class="container footer-content">
      <div class="footer-principal">
        <p class="footer-linea">Patricia Mayo · Makeup Artist</p>
        <p class="footer-linea">Gijón · Asturias</p>
        <p class="footer-linea">
          <a href={negocio.instagram} target="_blank" rel="noopener noreferrer" class="footer-ig">@makeuppatti</a>
        </p>
      </div>

      <div class="footer-legal">
        <a href="/aviso-legal">Aviso Legal</a>
        <span class="footer-legal-sep">·</span>
        <a href="/privacidad">Política de Privacidad</a>
        <span class="footer-legal-sep">·</span>
        <span>© 2026 Patricia Mayo</span>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Menú Hamburguesa interactivo
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuLinks = document.querySelectorAll('.menu-link');

  function openMenu() {
    mobileMenu?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.remove('active');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);

  menuLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>

<style>
  /* Header transparente integrado dentro de la foto */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.25rem 0;
    background: transparent;
    border-bottom: none;
    width: 100%;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-img {
    height: 26px;
    max-width: 180px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: brightness(0) invert(1); /* Pasa el logo a crema/blanco sobre la foto */
  }

  /* Menú Hamburguesa en crema sobre la foto */
  .menu-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    padding: 8px;
    z-index: 110;
    flex-shrink: 0;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-crema);
    transition: transform 0.3s ease, opacity 0.3s ease;
    border-radius: 1px;
  }

  /* Mobile menu overlay */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    z-index: 300;
    background-color: var(--color-negro);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-menu.active {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: transparent;
    border: none;
    color: var(--color-crema);
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem;
  }

  .menu-list {
    list-style: none;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .menu-link {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-crema);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .menu-link:hover {
    color: var(--color-terracota);
  }

  /* SECCIÓN 1 — HERO */
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 650px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-bg-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg, 
      rgba(13, 13, 13, 0.45) 0%, 
      rgba(13, 13, 13, 0.2) 50%, 
      rgba(13, 13, 13, 0.85) 100%
    );
  }

  .hero-content-container {
    position: relative;
    z-index: 10;
    padding-bottom: 9.75rem;
    transform: translateY(15px);
  }

  .hero-text-block {
    max-width: 920px;
  }

  .hero-heading {
    display: flex;
    flex-direction: column;
    margin-bottom: 2rem;
  }

  .hero-line {
    font-family: var(--font-serif);
    font-size: clamp(3.75rem, 8.5vw, 6.75rem);
    color: var(--color-crema);
    line-height: 1.06;
    word-break: break-word;
  }

  /* BOTONES DE CONTACTO FLOTANTES FIJOS (A LA DERECHA, PERMANECEN FIJOS AL SCROLL) */
  .floating-contact-bar {
    position: fixed;
    right: 1.75rem;
    bottom: 2.5rem;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .floating-contact-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(13, 13, 13, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(224, 118, 77, 0.4);
    color: var(--color-crema);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    text-decoration: none;
  }

  .floating-contact-btn.whatsapp-btn {
    background: var(--color-terracota);
    color: var(--color-crema);
    border-color: transparent;
  }

  .floating-contact-btn:hover {
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 12px 28px rgba(224, 118, 77, 0.5);
    border-color: var(--color-terracota);
  }

  .hero-whatsapp-btn {
    background-color: var(--color-terracota);
    color: var(--color-crema);
    border: 1px solid transparent;
  }

  .hero-whatsapp-btn:hover {
    background-color: #d0653d;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 10px 25px rgba(224, 118, 77, 0.45);
  }

  .hero-email-btn {
    background-color: rgba(255, 255, 255, 0.12);
    color: var(--color-crema);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero-email-btn:hover {
    background-color: rgba(255, 255, 255, 0.22);
    border-color: var(--color-crema);
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 10px 25px rgba(255, 255, 255, 0.2);
  }

  /* SECCIÓN 2 — GALERÍA CORTA */
  .galeria-corta {
    padding: 0;
    overflow: hidden;
  }

  .container-fluid {
    width: 100%;
    padding: 0;
  }

  .galeria-corta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    gap: 0;
  }

  .galeria-corta-item {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .galeria-corta-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transition: transform 0.5s ease;
  }

  .galeria-corta-item:hover img {
    transform: scale(1.03);
  }

  /* SECCIÓN 3 — FRASE DE CLIENTA */
  .frase-clienta {
    padding: 3.5rem 1.5rem;
    text-align: center;
  }

  .frase-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .quote-text {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: var(--color-grafito);
    line-height: 1.25;
    margin-bottom: 1.25rem;
    font-weight: 400;
  }

  .quote-author {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-grafito);
    opacity: 0.65;
    display: block;
  }

  /* SECCIÓN 4 — SERVICIOS */
  .servicios-section {
    padding: 4rem 1.5rem 4.5rem;
  }

  .servicios-container {
    max-width: 900px;
  }

  .servicios-intro {
    margin-bottom: 2.5rem;
  }

  .servicios-saludo {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    color: var(--color-grafito);
    line-height: 1.15;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .servicios-bio-intro {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    color: var(--color-grafito);
    line-height: 1.45;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .servicios-bajada {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-terracota);
    font-weight: 600;
  }

  .servicios-lista {
    display: flex;
    flex-direction: column;
  }

  .servicio-bloque {
    display: flex;
    flex-direction: column;
  }

  .servicio-divider {
    border: none;
    height: 1px;
    background-color: var(--color-terracota);
    opacity: 0.6;
    margin: 2.5rem 0;
  }

  .servicio-contenido {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .servicio-bloque .numero-servicio {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .servicio-titulo {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--color-grafito);
    margin-bottom: 1rem;
  }

  .servicio-descripcion {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: var(--color-grafito);
    line-height: 1.7;
    max-width: 720px;
    opacity: 0.9;
  }

  /* SECCIÓN 5 — GALERÍA COMPLETA */
  .galeria-completa {
    padding: 4.5rem 1.5rem;
  }

  .galeria-titulo-principal {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    color: var(--color-crema);
    line-height: 1.15;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .galeria-pendiente-box {
    border: 1px dashed rgba(224, 118, 77, 0.4);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 4px;
    padding: 3rem 2rem;
    text-align: center;
    max-width: 650px;
    margin: 0 auto;
  }

  .galeria-pendiente-texto {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    color: var(--color-crema);
    line-height: 1.3;
    margin-bottom: 0.85rem;
    font-weight: 400;
  }

  .galeria-pendiente-sub {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-terracota);
    opacity: 0.85;
    display: block;
  }

  /* SECCIÓN 6 — SOBRE PATRICIA */
  .sobre-patricia {
    padding: 8rem 1.5rem;
  }

  .sobre-container {
    max-width: 1100px;
  }

  .sobre-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .sobre-col-foto {
    width: 100%;
  }

  .sobre-foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .sobre-col-texto {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sobre-parrafo {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    color: var(--color-grafito);
    line-height: 1.5;
  }

  .sobre-destacado {
    font-size: 1.625rem;
  }

  .sobre-destacado-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--color-terracota);
  }

  .sobre-criterio {
    font-style: italic;
    color: var(--color-terracota);
    font-size: 1.5rem;
  }

  /* SECCIÓN 7 — RESERVAR */
  .reservar-section {
    padding: 4.5rem 1.5rem 6rem;
    text-align: center;
  }

  .reservar-container {
    max-width: 700px;
  }

  .reservar-titulo {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 4.5vw, 3.75rem);
    color: var(--color-grafito);
    margin-bottom: 1.25rem;
  }

  .reservar-subtitulo {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    color: var(--color-grafito);
    opacity: 0.85;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .btn-reservar-lg {
    font-size: 1.1875rem;
    padding: 1.25rem 2.75rem;
  }

  .reservar-buttons-group {
    display: flex;
    flex-direction: row;
    gap: 1.25rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-email-reservar {
