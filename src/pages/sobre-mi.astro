---
import Layout from '../layouts/Layout.astro';
import { negocio } from '../data/negocio';

const title = "Sobre mí · Patricia Mayo Makeup Artist · Gijón, Asturias";
const description = "Conoce a Patricia Mayo, maquilladora profesional en Gijón y Asturias. Formación en Alberto Dugarte Institute, Chanel y Siroko.";
---

<Layout title={title} description={description}>
  <!-- HEADER BLANCO CON LOGO Y HAMBURGUESA EN NEGRO -->
  <header class="site-header site-header-blanco">
    <div class="container header-inner">
      <!-- Menú Hamburguesa en la izquierda (NEGRO) -->
      <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menú">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- Logo en la derecha (NEGRO) -->
      <a href="/" class="logo-link">
        <img src="/logo.png" alt="Patricia Mayo" class="logo-img logo-negro" />
      </a>

      <!-- Overlay Menú Navegación -->
      <nav id="mobile-menu" class="mobile-menu bg-negro">
        <button id="menu-close" class="menu-close" aria-label="Cerrar menú">&times;</button>
        <ul class="menu-list">
          <li><a href="/#servicios" class="menu-link">Lo que puedo hacer por ti</a></li>
          <li><a href="/#galeria" class="menu-link">Galería</a></li>
          <li><a href="/sobre-mi" class="menu-link text-terracota">Sobre mí</a></li>
          <li><a href="/#reservar" class="menu-link">Reservar</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- BOTONES DE CONTACTO FLOTANTES FIJOS (A LA DERECHA) -->
  <div class="floating-contact-bar">
    <a 
      href="https://wa.me/34691352577?text=Hola%20Patricia%2C%20he%20le%C3%ADdo%20tu%20historia%20y%20me%20gustar%C3%ADa%20reservar." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="floating-contact-btn whatsapp-btn"
      aria-label="Contactar por WhatsApp"
      title="WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.205 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </a>

    <a 
      href="mailto:makeuppatti@gmail.com" 
      class="floating-contact-btn email-btn"
      aria-label="Enviar un Email"
      title="Email"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="16" x="2" y="4" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
    </a>
  </div>

  <main class="page-sobre-mi bg-crema">
    <section class="sobre-hero container">
      <h1 class="sobre-titulo-principal">Sobre mí</h1>
      
      <div class="sobre-grid">
        <div class="sobre-col-foto">
          <img src="/patricia.jpg" alt="Patricia Mayo Makeup Artist" class="sobre-foto" />
        </div>
        <div class="sobre-col-texto">
          <p class="sobre-parrafo sobre-destacado">
            Hay una foto mía con doce años pintándole los ojos a una amiga antes de una fiesta de cumpleaños. Mi amiga llegó a la fiesta y todo el mundo le preguntó qué se había hecho.
          </p>
          <p class="sobre-parrafo sobre-destacado-sub">
            Yo no lo sabía entonces, pero ya había encontrado lo mío.
          </p>
          <p class="sobre-parrafo">
            Años después me fui a Madrid a formarme, en el Alberto Dugarte Institute. Regresé a Gijón y trabajé como asesora de imagen para Chanel y para clientas que llegaban con prisa y se iban con otra cara. Luego vinieron los shootings para Siroko, sesiones de moda, fotógrafos que exigen con rapidez exactamente lo que necesitan y ni un milímetro más.
          </p>
          <p class="sobre-parrafo">
            En Asturias está mi gente y son las que me llaman para la boda de su hermana. Las que aparecen el sábado a las siete de la tarde con un vestido y sin saber qué hacer con la raya del ojo. Las que llevan años poniéndose en mis manos.
          </p>
          <p class="sobre-parrafo sobre-criterio">
            Pero me desplazo a donde haga falta cuando la ocasión lo merece. Sigo haciendo básicamente lo mismo que con doce años.<br />
            <strong>Solo que ahora sé lo que hago.</strong>
          </p>
          
          <div class="sobre-cta">
            <a 
              href="https://wa.me/34691352577?text=Hola%20Patricia%2C%20he%20le%C3%ADdo%20tu%20historia%20y%20me%20gustar%C3%ADa%20reservar." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-naranja"
            >
              &rarr; Escríbeme por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer bg-negro">
    <div class="container footer-content">
      <div class="footer-principal">
        <span class="footer-linea">Patricia Mayo</span>
        <span class="footer-linea">Makeup Artist</span>
        <span class="footer-linea">Gijón · Asturias</span>
      </div>

      <div class="footer-legal">
        <a href="/" class="footer-ig">Inicio</a> · 
        <a href="/aviso-legal" class="footer-ig">Aviso legal</a> · 
        <a href="/privacidad" class="footer-ig">Política de privacidad</a>
      </div>
    </div>
  </footer>

  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const mobileMenu = document.getElementById('mobile-menu');

    menuToggle?.addEventListener('click', () => {
      mobileMenu?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    });

    menuClose?.addEventListener('click', () => {
      mobileMenu?.classList.remove('is-open');
      document.body.style.overflow = '';
    });
  </script>
</Layout>

<style>
  .site-header-blanco {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: #ffffff !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    padding: 4px 0;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-img.logo-negro {
    height: 70px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) !important;
  }

  .menu-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
  }

  .site-header-blanco .hamburger-line {
    width: 28px;
    height: 2px;
    background-color: #0d0d0d !important;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 200;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-close {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: transparent;
    border: none;
    color: var(--color-crema);
    font-size: 3rem;
    cursor: pointer;
  }

  .menu-list {
    list-style: none;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .menu-link {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--color-crema);
    text-decoration: none;
  }

  .text-terracota {
    color: var(--color-terracota);
  }

  .floating-contact-bar {
    position: fixed;
    right: 1.75rem;
    bottom: 2.5rem;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .floating-contact-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(13, 13, 13, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(224, 118, 77, 0.4);
    color: var(--color-crema);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    text-decoration: none;
  }

  .floating-contact-btn.whatsapp-btn {
    background: var(--color-terracota);
    color: var(--color-crema);
    border-color: transparent;
  }

  .floating-contact-btn:hover {
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 12px 28px rgba(224, 118, 77, 0.5);
  }

  .page-sobre-mi {
    min-height: 100vh;
    padding-top: 10rem;
    padding-bottom: 8rem;
  }

  .sobre-titulo-principal {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-grafito);
    margin-bottom: 4rem;
  }

  .sobre-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: flex-start;
  }

  .sobre-col-foto {
    width: 100%;
  }

  .sobre-foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
  }

  .sobre-col-texto {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sobre-parrafo {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-grafito);
    line-height: 1.6;
  }

  .sobre-destacado {
    font-size: 1.5rem;
  }

  .sobre-destacado-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--color-terracota);
  }

  .sobre-criterio {
    font-style: italic;
    color: var(--color-terracota);
    font-size: 1.4rem;
  }

  .sobre-cta {
    margin-top: 1.5rem;
  }

  .btn-naranja {
    display: inline-block;
    background-color: var(--color-terracota);
    color: var(--color-crema);
    padding: 1.1rem 2.2rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(224, 118, 77, 0.3);
  }

  .btn-naranja:hover {
    background-color: #d0653d;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(224, 118, 77, 0.45);
  }

  .site-footer {
    padding: 4rem 1.5rem;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .footer-principal {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }

  .footer-linea {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-crema);
  }

  .footer-legal {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(242, 239, 232, 0.4);
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .footer-ig {
    color: var(--color-crema);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .sobre-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
